{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icad.local/schemas/ra_workbench_state_v8.schema.json",
  "title": "RA Workbench State v8",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "caseId", "generatorAuthoring", "dependencyRecompute", "aiReviewQueue"],
  "properties": {
    "version": {"const": "8.0"},
    "caseId": {"type": "string", "minLength": 1},
    "generatorAuthoring": {"type": ["object", "null"]},
    "dependencyRecompute": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "ra_dependency_recompute_v1.schema.json"}
      ]
    },
    "aiReviewQueue": {"type": ["object", "null"]}
  }
}
