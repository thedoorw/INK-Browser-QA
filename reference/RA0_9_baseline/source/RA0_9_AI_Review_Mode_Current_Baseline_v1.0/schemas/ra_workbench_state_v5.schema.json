{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icad.local/schemas/ra_workbench_state_v5.schema.json",
  "title": "RA Workbench State v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "caseId", "semanticBoundaryResolution", "aiReviewQueue", "selectedReviewId"],
  "properties": {
    "version": {"const": "5.0"},
    "caseId": {"type": "string", "minLength": 1},
    "semanticBoundaryResolution": {"type": ["object", "null"]},
    "aiReviewQueue": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "ra_ai_review_queue_v1.schema.json"}
      ]
    },
    "selectedReviewId": {"type": ["string", "null"]}
  }
}
