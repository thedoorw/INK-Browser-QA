{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ink.local/schema/ink-brush-package-v1.json",
  "title": "INK Brush Package v1",
  "type": "object",
  "required": ["format", "schemaVersion", "id", "name", "metadata", "presets", "assets", "dependencies", "license", "compatibleVersion", "knownLimits", "security", "packageHash"],
  "properties": {
    "format": { "const": "INK-BRUSH-PACKAGE" }, "schemaVersion": { "const": 1 },
    "id": { "type": "string" }, "name": { "type": "string" }, "metadata": { "type": "object" },
    "presets": { "type": "array", "minItems": 1 }, "assets": { "type": "array" }, "dependencies": { "type": "array" },
    "license": { "type": "object", "required": ["spdx"] }, "compatibleVersion": { "type": "string" }, "knownLimits": { "type": "array" },
    "security": { "type": "object", "required": ["executableAssetsAllowed", "scanned"] }, "packageHash": { "type": "string" }
  }
}
