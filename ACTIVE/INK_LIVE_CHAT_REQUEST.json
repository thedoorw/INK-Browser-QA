{
  "schema": "INK-LIVE-CHAT-REQUEST",
  "version": 1,
  "requestId": "clusterB-B2-effect-live-002",
  "liveUrl": "https://thedoorw.github.io/INK/",
  "expectedSourceSha": "9d73a8018c0c37861aa3c76412951eb26bf78e62",
  "steps": [
    {
      "id": "capabilities",
      "tool": "get_ink_capabilities",
      "input": {}
    },
    {
      "id": "importRaster",
      "tool": "import_ink_raster",
      "input": {
        "options": {
          "name": "B2 Effect Raster",
          "type": "image/png",
          "intent": "Cluster B2 colorOverlay effect qualification"
        }
      },
      "file": {
        "path": "qa/fixtures/rose-window/rose-window-primary.png",
        "name": "rose-window-primary.png",
        "type": "image/png"
      }
    },
    {
      "id": "previewBefore",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "effectPropose",
      "tool": "propose_ink_edit",
      "input": {
        "task": {
          "schema": "INK-CHAT-EDIT-TASK",
          "version": 1,
          "taskId": "clusterB-B2-live-effect-color-overlay",
          "operation": "image.effect.add.v1",
          "targets": [
            {
              "$ref": "importRaster.createdRefs.0"
            }
          ],
          "arguments": {
            "type": "colorOverlay",
            "params": {
              "color": "#00cc66"
            },
            "opacity": 0.55
          }
        }
      }
    },
    {
      "id": "effectApprove",
      "tool": "approve_ink_edit",
      "input": {
        "proposalId": {
          "$ref": "effectPropose.result.result.proposalId"
        }
      }
    },
    {
      "id": "effectExecute",
      "tool": "execute_ink_edit",
      "input": {
        "proposalId": {
          "$ref": "effectPropose.result.result.proposalId"
        },
        "approvalToken": {
          "$ref": "effectApprove.result.result.approvalToken"
        }
      }
    },
    {
      "id": "contextAfter",
      "tool": "get_ink_context",
      "input": {
        "maxObjects": 20
      }
    },
    {
      "id": "historyAfter",
      "tool": "get_ink_history",
      "input": {}
    },
    {
      "id": "previewAfter",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "undo",
      "tool": "undo_ink",
      "input": {}
    },
    {
      "id": "contextUndo",
      "tool": "get_ink_context",
      "input": {
        "maxObjects": 20
      }
    },
    {
      "id": "previewUndo",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "redo",
      "tool": "redo_ink",
      "input": {}
    },
    {
