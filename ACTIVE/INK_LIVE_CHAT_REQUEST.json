{
  "schema": "INK-LIVE-CHAT-REQUEST",
  "version": 1,
  "requestId": "clusterB-advanced-raster-ingest-live-001",
  "liveUrl": "https://thedoorw.github.io/INK/",
  "expectedSourceSha": "8d5a8ee9fdd0b4e2c63d910e75f29d48514ccf3f",
  "steps": [
    {
      "id": "describeImport",
      "tool": "describe_ink_capability",
      "input": {
        "idOrToolName": "raster.import"
      }
    },
    {
      "id": "historyBefore",
      "tool": "get_ink_history",
      "input": {}
    },
    {
      "id": "psd",
      "tool": "import_ink_raster",
      "input": {
        "options": {
          "name": "Live Advanced PSD",
          "type": "image/vnd.adobe.photoshop",
          "matrix": [
            1,
            0,
            0,
            1,
            0,
            0
          ],
          "intent": "advanced mutable raster formal Live"
        }
      },
      "file": {
        "generatedFormat": "PSD",
        "name": "live-advanced.psd",
        "type": "image/vnd.adobe.photoshop"
      }
    },
    {
      "id": "previewPSD",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "tiff",
      "tool": "import_ink_raster",
      "input": {
        "options": {
          "name": "Live Advanced TIFF",
          "type": "image/tiff",
          "matrix": [
            1,
            0,
            0,
            1,
            24,
            0
          ],
          "intent": "advanced mutable raster formal Live"
        }
      },
      "file": {
        "generatedFormat": "TIFF",
        "name": "live-advanced.tiff",
        "type": "image/tiff"
      }
    },
    {
      "id": "previewTIFF",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "exr",
      "tool": "import_ink_raster",
      "input": {
        "options": {
          "name": "Live Advanced EXR",
          "type": "image/x-exr",
          "matrix": [
            1,
            0,
            0,
            1,
            48,
            0
          ],
          "intent": "advanced mutable raster formal Live"
        }
      },
      "file": {
        "generatedFormat": "EXR",
        "name": "live-advanced.exr",
        "type": "image/x-exr"
      }
    },
    {
      "id": "previewEXR",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "historyAfterImports",
      "tool": "get_ink_history",
      "input": {}
    },
    {
      "id": "undoEXR",
      "tool": "undo_ink",
      "input": {}
    },
    {
      "id": "previewUndoEXR",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "redoEXR",
      "tool": "redo_ink",
      "input": {}
    },
    {
      "id": "previewRedoEXR",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "bucketPropose",
      "tool": "propose_ink_edit",
      "input": {
        "task": {
          "schema": "INK-CHAT-EDIT-TASK",
          "version": 1,
          "taskId": "live-advanced-psd-bucket",
          "operation": "image.raster.paintBucket.v1",
          "targets": [
            {
              "$ref": "psd.createdRefs.0"
            }
          ],
          "arguments": {
            "x": 0,
            "y": 0,
            "color": "#20b86a",
            "tolerance": 0,
            "contiguous": true,
            "opacity": 1
          }
        }
      }
    },
    {
      "id": "bucketApprove",
      "tool": "approve_ink_edit",
      "input": {
        "proposalId": {
          "$ref": "bucketPropose.result.result.proposalId"
        }
      }
    },
    {
      "id": "bucketExecute",
      "tool": "execute_ink_edit",
      "input": {
        "proposalId": {
          "$ref": "bucketPropose.result.result.proposalId"
        },
        "approvalToken": {
          "$ref": "bucketApprove.result.result.approvalToken"
        }
      }
    },
    {
      "id": "previewPsdEdit",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "undoPsdEdit",
      "tool": "undo_ink",
      "input": {}
    },
    {
      "id": "previewUndoPsdEdit",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "redoPsdEdit",
      "tool": "redo_ink",
      "input": {}
    },
    {
      "id": "previewRedoPsdEdit",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "rawUnavailable",
      "tool": "import_ink_raster",
      "allowFailure": true,
      "input": {
        "options": {
          "name": "Live RAW unavailable",
          "type": "image/x-adobe-dng",
          "intent": "verify default RAW decoder boundary"
        }
      },
      "file": {
        "generatedFormat": "RAW_UNAVAILABLE",
        "name": "live-camera.dng",
        "type": "image/x-adobe-dng"
      }
    },
    {
      "id": "contextFinal",
      "tool": "get_ink_context",
      "input": {
        "maxObjects": 20
      }
    },
    {
      "id": "historyFinal",
      "tool": "get_ink_history",
      "input": {}
    }
  ]
