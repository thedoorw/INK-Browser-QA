{
  "schema": "INK-LIVE-CHAT-REQUEST",
  "version": 1,
  "requestId": "clusterB-B3-paint-bucket-live-001",
  "liveUrl": "https://thedoorw.github.io/INK/",
  "expectedSourceSha": "d64aa172ef6d4f3c100642aec8bcc4195c33b2dd",
  "steps": [
    {
      "id": "describe",
      "tool": "describe_ink_capability",
      "input": {
        "idOrToolName": "image.raster.paintBucket.v1"
      }
    },
    {
      "id": "importRaster",
      "tool": "import_ink_raster",
      "input": {
        "options": {
          "name": "B3 Editable Raster",
          "type": "image/png",
          "intent": "B3 destructive Paint Bucket formal Live qualification"
        }
      },
      "file": {
        "path": "qa/fixtures/rose-window/rose-window-primary.png",
        "name": "rose-window-primary.png",
        "type": "image/png"
      }
    },
    {
      "id": "contextImported",
      "tool": "get_ink_context",
      "input": {
        "maxObjects": 20
      }
    },
    {
      "id": "previewBefore",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "fillPropose",
      "tool": "propose_ink_edit",
      "input": {
        "task": {
          "schema": "INK-CHAT-EDIT-TASK",
          "version": 1,
          "taskId": "clusterB-B3-live-paint-bucket",
          "operation": "image.raster.paintBucket.v1",
          "targets": [
            {
              "$ref": "importRaster.createdRefs.0"
            }
          ],
          "arguments": {
            "x": 5,
            "y": 5,
            "color": "#20b86a",
            "tolerance": 0,
            "contiguous": true,
            "opacity": 1
          }
        }
      }
    },
    {
      "id": "fillApprove",
      "tool": "approve_ink_edit",
      "input": {
        "proposalId": {
          "$ref": "fillPropose.result.result.proposalId"
        }
      }
    },
    {
      "id": "fillExecute",
      "tool": "execute_ink_edit",
      "input": {
        "proposalId": {
          "$ref": "fillPropose.result.result.proposalId"
        },
        "approvalToken": {
          "$ref": "fillApprove.result.result.approvalToken"
        }
      }
    },
    {
      "id": "contextAfter",
      "tool": "get_ink_context",
      "input": {
        "maxObjects": 20
      }
    },
    {
      "id": "historyAfter",
      "tool": "get_ink_history",
      "input": {}
    },
    {
      "id": "previewAfter",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "noOpPropose",
      "tool": "propose_ink_edit",
      "input": {
        "task": {
          "schema": "INK-CHAT-EDIT-TASK",
          "version": 1,
          "taskId": "clusterB-B3-live-paint-bucket-noop",
          "operation": "image.raster.paintBucket.v1",
          "targets": [
            {
              "$ref": "importRaster.createdRefs.0"
            }
          ],
          "arguments": {
            "x": 5,
            "y": 5,
            "color": "#20b86a",
            "tolerance": 0,
            "contiguous": true,
            "opacity": 1
          }
        }
      }
    },
    {
      "id": "noOpApprove",
      "tool": "approve_ink_edit",
      "input": {
        "proposalId": {
          "$ref": "noOpPropose.result.result.proposalId"
        }
      }
    },
    {
      "id": "noOpExecute",
      "tool": "execute_ink_edit",
      "allowFailure": true,
      "input": {
        "proposalId": {
          "$ref": "noOpPropose.result.result.proposalId"
        },
        "approvalToken": {
          "$ref": "noOpApprove.result.result.approvalToken"
        }
      }
    },
    {
      "id": "undo",
      "tool": "undo_ink",
      "input": {}
    },
    {
      "id": "previewUndo",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "redo",
      "tool": "redo_ink",
      "input": {}
    },
    {
      "id": "previewRedo",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "historyFinal",
      "tool": "get_ink_history",
      "input": {}
    }
  ]
}
