{
  "schema": "INK-LIVE-CHAT-REQUEST",
  "version": 1,
  "requestId": "clusterB-B2-filter-live-002",
  "liveUrl": "https://thedoorw.github.io/INK/",
  "expectedSourceSha": "e2ce5e409f42c992bcf411e5e23d8f02435b1a63",
  "steps": [
    {
      "id": "capabilities",
      "tool": "get_ink_capabilities",
      "input": {}
    },
    {
      "id": "importRaster",
      "tool": "import_ink_raster",
      "input": {
        "options": {
          "name": "B2 Filter Raster",
          "type": "image/png",
          "intent": "Cluster B2 native gaussianBlur qualification"
        }
      },
      "file": {
        "path": "qa/fixtures/rose-window/rose-window-primary.png",
        "name": "rose-window-primary.png",
        "type": "image/png"
      }
    },
    {
      "id": "previewBefore",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "filterPropose",
      "tool": "propose_ink_edit",
      "input": {
        "task": {
          "schema": "INK-CHAT-EDIT-TASK",
          "version": 1,
          "taskId": "clusterB-B2-live-gaussian-blur",
          "operation": "image.filter.add.v1",
          "targets": [
            {
              "$ref": "importRaster.createdRefs.0"
            }
          ],
          "arguments": {
            "type": "gaussianBlur",
            "params": {
              "radius": 2
            },
            "opacity": 1
          }
        }
      }
    },
    {
      "id": "filterApprove",
      "tool": "approve_ink_edit",
      "input": {
        "proposalId": {
          "$ref": "filterPropose.result.result.proposalId"
        }
      }
    },
    {
      "id": "filterExecute",
      "tool": "execute_ink_edit",
      "input": {
        "proposalId": {
          "$ref": "filterPropose.result.result.proposalId"
        },
        "approvalToken": {
          "$ref": "filterApprove.result.result.approvalToken"
        }
      }
    },
    {
      "id": "contextAfter",
      "tool": "get_ink_context",
      "input": {
        "maxObjects": 20
      }
    },
    {
      "id": "historyAfter",
      "tool": "get_ink_history",
      "input": {}
    },
    {
      "id": "previewAfter",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "undo",
      "tool": "undo_ink",
      "input": {}
    },
    {
      "id": "contextUndo",
      "tool": "get_ink_context",
      "input": {
        "maxObjects": 20
      }
    },
    {
      "id": "previewUndo",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    },
    {
      "id": "redo",
      "tool": "redo_ink",
      "input": {}
    },
    {
      "id": "contextRedo",
      "tool": "get_ink_context",
      "input": {
        "maxObjects": 20
      }
    },
    {
      "id": "previewRedo",
      "tool": "get_ink_preview",
      "input": {
        "scope": "content",
        "maxDimension": 800,
        "background": true
      }
    }
  ]
}
