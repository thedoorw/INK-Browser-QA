{
  "name": "ink-core-main-program",
  "version": "1.6.5-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "start:local": "node scripts/serve.mjs --host 127.0.0.1 --port 4173",
    "fixtures": "node scripts/generate-test-fixtures.mjs",
    "test:ready": "node scripts/test-ready-check-v151.mjs",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "build": "node scripts/build-compat.mjs",
    "benchmark": "node scripts/generate-v151-rc-deliverables.mjs",
    "test:browser": "node scripts/browser-smoke-v151.mjs",
    "test:conversation": "node scripts/conversation-smoke-test-v1.mjs",
    "test:ai-chat": "node --test --test-concurrency=1 tests/unit/ai-command-layer-v150.test.mjs tests/unit/chat-runtime-v151.test.mjs",
    "test:web": "npm run test:browser",
    "test:headless": "node --test --test-concurrency=1 tests/headless/*.test.mjs tests/intent/*.test.mjs tests/session/*.test.mjs tests/preservation/*.test.mjs tests/qa/*.test.mjs tests/cli/*.test.mjs tests/determinism/*.test.mjs",
    "test:headless:smoke": "node scripts/headless-conversation-smoke-v1.mjs",
    "ink:doctor": "node scripts/ink-doctor.mjs",
    "test:v160": "node --test --test-concurrency=1 tests/v160/*.test.mjs",
    "test:v161": "node --test --test-concurrency=1 tests/v161/*.test.mjs",
    "test:v1.6": "npm run test:v160 && npm run test:v161 && npm run test:v162",
    "test:dependency": "node --test --test-concurrency=1 tests/dependency/*.test.mjs",
    "check": "npm run build && npm run typecheck && npm test && npm run test:browser && npm run test:ready",
    "test:v162": "node --test --test-concurrency=1 tests/v162/*.test.mjs",
    "test:v163": "node --test --test-concurrency=1 tests/v163/*.test.mjs",
    "test:v163:id": "node --test --test-concurrency=1 tests/v163-id/*.test.mjs",
    "test:v1.6.3": "npm run test:v160 && npm run test:v161 && npm run test:v162 && npm run test:v163 && npm run test:v163:id",
    "test:v164": "node --test --test-concurrency=1 tests/v164/*.test.mjs",
    "test:v1.6.4": "npm run test:v160 && npm run test:v161 && npm run test:v162 && npm run test:v163 && npm run test:v163:id && npm run test:v164",
    "test:v165": "node --test --test-concurrency=1 tests/v165/*.test.mjs",
    "test:v1.6.5": "npm run test:v160 && npm run test:v161 && npm run test:v162 && npm run test:v163 && npm run test:v163:id && npm run test:v164 && npm run test:v165"
  },
  "bin": {
    "ink-doctor": "scripts/ink-doctor.mjs",
    "ink-plan": "scripts/ink-cli.mjs",
    "ink-preview": "scripts/ink-cli.mjs",
    "ink-approve": "scripts/ink-cli.mjs",
    "ink-execute": "scripts/ink-cli.mjs",
    "ink-export": "scripts/ink-cli.mjs",
    "ink-modify": "scripts/ink-cli.mjs",
    "ink-rollback": "scripts/ink-cli.mjs",
    "ink-recipe": "scripts/ink-recipe.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}
